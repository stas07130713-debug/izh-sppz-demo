{
  "name": "izh-sppz",
  "version": "0.1.0",
  "private": true,
  "description": "ИЖ СППЗ — интерактивный журнал систем противопожарной защиты",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "dev": "npm run dev --workspace @izh/desktop",
    "build": "npm run build --workspace @izh/desktop",
    "web:export-demo": "vite-node tools/export-web-demo-data.ts",
    "web:build": "vite build --config packages/desktop/web.vite.config.ts",
    "web:preview": "vite preview --config packages/desktop/web.vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
